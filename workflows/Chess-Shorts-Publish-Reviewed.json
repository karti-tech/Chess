      "name": "Official YouTube Upload",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 1800000
        },
        "method": "POST",
        "url": "=http://host.docker.internal:8765/jobs/{{$json.job_id}}/publish",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\"approved\":true}"
