      "position": [
        480,
        0
      ],
      "parameters": {
        "jsCode": "const j=$input.first().json; if(!j.approved || j.job_id.startsWith('REPLACE')) throw new Error('Review the MP4, enter job_id, and set approved=true. Dry-run jobs cannot publish.'); return [{json:j}];"
      }
    },
